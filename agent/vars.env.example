# API Keys
NVIDIA_API_KEY="" 
NGC_API_KEY="" 
TAVILY_API_KEY="tvly-"

# Main Agent LLM — MMSE conversation + scoring
# To switch models, change AGENT_LLM_MODEL to any model on https://build.nvidia.com
# Examples:
#   meta/llama-3.3-70b-instruct
#   deepseek-ai/deepseek-r1-distill-qwen-7b
#   meta/llama-3.1-70b-instruct
# set AGENT_LLM_BASE_URL to "http://agent-instruct-llm:8000/v1" if self-hosting
AGENT_LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
AGENT_LLM_MODEL="meta/llama-3.3-70b-instruct"
# AGENT_LLM_MODEL="openai/gpt-oss-120b"
# AGENT_LLM_MODEL="nvcr.io/nim/nvidia/nemotron-3-nano"

# LLM used specifically for Neo4j entity extraction in agentic memory.
# Structured JSON output is required, so a model that follows instructions well
# is recommended. Defaults to llama-3.3 if not set.
# Change independently of AGENT_LLM_MODEL if needed.
# MEMORY_LLM_MODEL="meta/llama-3.3-70b-instruct"
MEMORY_LLM_MODEL="meta/llama-3.3-70b-instruct"
# MEMORY_LLM_MODEL="openai/gpt-oss-120b"

# Logging
LOG_LEVEL="INFO"

# Remote debugging — uncomment to enable debugpy (VS Code attach on port 5678)
# After changing, restart the container: docker compose -f docker-compose.yaml up -d app-server
DEBUGPY_PORT=5678

# Optional guardrails configdera
NEMO_GUARDRAILS_CONFIG_PATH=""

# Optional LangSmith
LANGSMITH_TRACING=""
LANGSMITH_ENDPOINT=""
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""

# Optional Langfuse Prompt Management (for system prompts)
LANGFUSE_PUBLIC_KEY="pk-lf-b36d1cea-c612-4d8e-ac6d-65475d06bd37"
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="http://${BREV_SERVER_IP}:3000"
LANGFUSE_PROMPT_NAME="patient-intake-inital"
LANGFUSE_SCORING_PROMPT_NAME="mmse-agent-scoring"
LANGFUSE_PROMPT_LABEL="production"

# Runtime settings
TIMEZONE="America/Los_Angeles"
APP_OUTPUT_DIR="app_output_files"

# ── Neo4j Agentic Memory (neo4j-agent-memory) ────────────────────────────────
# Neo4j is accessed from inside Docker via host.docker.internal (host-gateway).
# Set NEO4J_PASSWORD to your actual Neo4j password to enable memory.
# Leave NEO4J_URI empty to disable memory entirely.
NEO4J_URI="bolt://host.docker.internal:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=
