# API Keys
NVIDIA_API_KEY="" 
NGC_API_KEY="" 
TAVILY_API_KEY="tvly-"

# Main Agent LLM
# set url to "http://agent-instruct-llm:8000/v1" if self hosting the llm
AGENT_LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
AGENT_LLM_MODEL="meta/llama-3.3-70b-instruct"

# Logging
LOG_LEVEL="INFO"

# Optional guardrails config
NEMO_GUARDRAILS_CONFIG_PATH=""

# Optional LangSmith
LANGSMITH_TRACING=""
LANGSMITH_ENDPOINT=""
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""

# Optional Langfuse Prompt Management (for system prompts)
LANGFUSE_PUBLIC_KEY="pk-lf-b36d1cea-c612-4d8e-ac6d-65475d06bd37"
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="http://${SERVER_IP}:3000"
LANGFUSE_PROMPT_NAME="patient-intake-inital"
LANGFUSE_SCORING_PROMPT_NAME="mmse-agent-scoring"
LANGFUSE_PROMPT_LABEL="production"

# Runtime settings
TIMEZONE="America/Los_Angeles"
APP_OUTPUT_DIR="app_output_files"

# ── Neo4j Agentic Memory (neo4j-agent-memory) ────────────────────────────────
# Neo4j is accessed from inside Docker via host.docker.internal (host-gateway).
# Set NEO4J_PASSWORD to your actual Neo4j password to enable memory.
# Leave NEO4J_URI empty to disable memory entirely.
NEO4J_URI="bolt://host.docker.internal:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"