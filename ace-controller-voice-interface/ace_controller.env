# API Keys
NGC_API_KEY=
NVIDIA_API_KEY=

# config file path
CONFIG_PATH=./configs/config_riva_hybrid.yaml
# CONFIG_PATH=./configs/config_riva_public_endpoints.yaml

# Timeout threshold for sending a request to the FastAPI server
# Increase this when backend uses hosted LLM endpoints, which can exceed 15s.
REQUEST_TIMEOUT=90.0

TURN_USERNAME=admin
TURN_PASSWORD=admin
TURN_SERVER_URL=turn:{$SERVER_IP}:3478